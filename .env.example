# ==========================================
# CONFIGURAÇÕES DA SECRETÁRIA IMOBILIÁRIA
# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.
# ==========================================

# Senha do painel (recomendado). Se vazio, o painel pede para criar a senha no 1º acesso
# usando o código de configuração que aparece no log do servidor.
PAINEL_SENHA=

# Pasta onde ficam sessão do WhatsApp, carteira, fotos e memória de contatos.
# Na nuvem aponte para um disco PERSISTENTE (ex: /var/data). Vazio = pasta do projeto.
DATA_DIR=

# Chave grátis do Google Gemini (opcional — reforça a leitura de nomes de lugares)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Seu WhatsApp para alertas (55 + DDD + número). Vazio = conversa "Mensagem para mim".
MEU_WHATSAPP_ALERTA=

# Planilha Google (opcional)
GOOGLE_SHEETS_CSV_URL=
GOOGLE_SHEETS_WEBHOOK_URL=
# Mesmo valor configurado no Apps Script (TOKEN) para o webhook aceitar a sincronização
GOOGLE_SHEETS_TOKEN=

# Token para scripts acessarem a API (ex: sync-from-cloud.js). Mínimo 16 caracteres.
API_TOKEN=

PORT=3000

# Plano Biga (uso justo; trava de margem bruta > 75%): radar | designer | imobiliaria
# radar: 100 buscas/mês, sem Apify, 1.500 pedidos com IA · designer: 200 buscas, 5 Apify, 3.000 IA
# imobiliaria: 800 buscas, 20 Apify, 12.000 IA. Vazio = instalação própria (chaves do corretor, sem teto mensal)
BIGA_PLANO=
