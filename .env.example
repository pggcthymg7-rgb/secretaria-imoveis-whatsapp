# ==========================================
# CONFIGURAÇÕES DO AGENTE IMOBILIÁRIO
# ==========================================

# 1. Chave da API do Google Gemini (Crie grátis em: https://aistudio.google.com/apikey)
GEMINI_API_KEY=coloque_sua_chave_aqui

# 2. Link CSV da sua Planilha do Google Sheets (Opcional - se vazio, usa o arquivo imoveis.csv local)
# No Google Sheets: Arquivo > Compartilhar > Publicar na Web > Formato: Valores separados por vírgula (.csv)
GOOGLE_SHEETS_CSV_URL=

# 3. Nome(s) ou ID(s) do(s) grupo(s) que o agente deve monitorar (separados por vírgula)
# Deixe em branco para monitorar TODOS os grupos onde o número estiver, ou filtre por nome (ex: "Imóveis Goiânia,Repasse Corretores")
GRUPOS_MONITORADOS=

# 4. Modo de Segurança / Teste:
# Se MODO_APENAS_AVISAR=true, o agente NÃO manda mensagem para a pessoa do grupo ainda; ele manda no SEU WhatsApp (ou no painel) dizendo o que encontrou.
# Mude para false quando estiver pronto para ele abordar os clientes automaticamente no privado!
MODO_APENAS_AVISAR=false

# 5. Seu número de WhatsApp (com DDI 55 + DDD, apenas números, ex: 5562999999999) para receber alertas de oportunidades encontradas
MEU_WHATSAPP_ALERTA=

# 6. Porta do Painel Web de Controle (http://localhost:3000)
PORT=3000
