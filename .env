# ==========================================
# CONFIGURAÇÕES DO AGENTE IMOBILIÁRIO
# ==========================================

# 1. Chave da API do Google Gemini (Crie grátis em: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 2. Link CSV da sua Planilha do Google Sheets (Opcional - se vazio, usa o arquivo imoveis.csv local)
# No Google Sheets: Arquivo > Compartilhar > Publicar na Web > Formato: Valores separados por vírgula (.csv)
GOOGLE_SHEETS_CSV_URL=

# 3. Nome(s) ou ID(s) do(s) grupo(s) que o agente deve monitorar (separados por vírgula)
# Deixe em branco para monitorar TODOS os grupos, ou digite parte do nome do grupo (ex: Imoveis,Corretores)
GRUPOS_MONITORADOS=teste

# 4. Modo de Segurança / Teste:
# Se true, apenas avisa você. Se false, aborda a pessoa no privado (DM) automaticamente!
MODO_APENAS_AVISAR=false

# 5. Seu número de WhatsApp (ex: 5562999999999) para receber cópia/alerta quando o robô encontrar um cliente
MEU_WHATSAPP_ALERTA=5562983443060

# 6. Porta do Painel Web de Controle
PORT=3000

GOOGLE_SHEETS_WEBHOOK_URL=
